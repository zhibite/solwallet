# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/.idea
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# deployment
/deploy
*.pid
*.log
logs/

# 数据库（如果本地备份）
/pgdata
/redisdata

# 编辑器
.vscode/*
!.vscode/extensions.json
.idea

# 临时调试脚本/截图（不纳入版本控制）
/tmp
# 根目录下的一次性探针与回归日志：_creditprobe.js / _reg2.txt …
# 这些是为排查配额、限流、PnL 回归临时写的一次性产物，跑完即弃。
/_*.js
/_*.txt
