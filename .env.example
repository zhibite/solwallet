# ===== PostgreSQL =====
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=solwallet
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_POOL_MAX=10

# ===== 缓存（可选） =====
# 不填则使用进程内 Map，多实例部署会丢失共享
# 本地启动 redis: docker run -d -p 6379:6379 redis:7-alpine
REDIS_URL=redis://127.0.0.1:6379

# ===== Solana 数据源 =====
# Helius API Key (必填) - https://dashboard.helius.dev
HELIUS_API_KEY=your-helius-api-key-here

# Birdeye API Key (可选，价格查询 fallback)
BIRDEYE_API_KEY=

# Solana RPC 列表（逗号分隔，自动按质量轮询 + 熔断）
# 推荐配置：1 个付费（稳定）+ 3-5 个免费（容灾）
# 包含 helius/alchemy/quicknode 字样的会作为付费端点优先使用
SOLANA_RPCS=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY,https://api.mainnet-beta.solana.com,https://rpc.ankr.com/solana,https://solana.publicnode.com,https://solana.api.onfinality.io/public

# ===== 监控行为 =====
# 轮询间隔（毫秒），仅在未启用 webhook 时生效
MONITOR_POLL_INTERVAL_MS=5000

# 是否使用 Helius Webhook（需要公网可访问的 URL）
HELIUS_USE_WEBHOOK=false
WEBHOOK_URL=https://solwallet.tokensee.com/api/webhooks/helius
